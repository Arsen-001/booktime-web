      { "click": "role=button[name=\"Получить код\"]" },
      { "expectText": "Код отправлен" },
      { "fill": "input[inputmode='numeric']", "value": "1111" },
      { "expectText": "Неверный код" },
      { "fill": "input[inputmode='numeric']", "value": "0000" },
      { "expectText": "Добро пожаловать" },
      { "wait": 800 },
      { "screenshot": "full-login-done" },
      { "click": "css=[data-client-tabbar] a[href='/profile']" },
      { "wait": 800 },
      { "screenshot": "full-login-profile" }
    ] },
