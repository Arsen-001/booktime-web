{
  "route": "/biz/integrations/developers",
  "persona": "owner",
  "lang": "ru",
  "device": "desktop",
  "steps": [
    { "click": "label:has-text(\"Согласен\") input[type=checkbox]" },
    { "fill": "label:has-text(\"Название компании-разработчика\") ~ input, label:has-text(\"Название компании-разработчика\") ~ div input", "value": "Lifecycle Co" },
    { "fill": "label:has-text(\"Для чего будет использоваться\") ~ textarea, label:has-text(\"Для чего будет использоваться\") ~ div textarea", "value": "Проверка жизненного цикла" },
    { "fill": "label:text-is(\"Имя\") ~ input, label:text-is(\"Имя\") ~ div input", "value": "Иван Тест" },
    { "fill": "label:text-is(\"Email\") ~ input, label:text-is(\"Email\") ~ div input", "value": "life@test.com" },
    { "click": "role=button[name=\"Зарегистрироваться\"]" },
    { "wait": 600 },
    { "click": "role=link[name=\"Создать приложение\"]" },
    { "wait": 400 },
    { "fill": "label:has-text(\"Название приложения\") ~ input, label:has-text(\"Название приложения\") ~ div input", "value": "Лайфцикл" },
    { "click": "role=button[name=\"Создать\"]" },
    { "wait": 600 },
    { "click": "text=О приложении" },
    { "wait": 300 },
    { "fill": "textarea", "value": "Описание тестового приложения для проверки модерации" },
    { "click": "role=button[name=\"Сохранить\"]" },
    { "wait": 500 },
    { "click": "text=Настройки для разработки" },
    { "wait": 300 },
    { "fill": "label:has-text(\"Registration Redirect Url\") ~ input, label:has-text(\"Registration Redirect Url\") ~ div input", "value": "https://example.com/register" },
    { "click": "role=button[name=\"Сохранить\"]" },
    { "wait": 500 },
    { "click": "text=Общая информация" },
    { "wait": 300 },
    { "screenshot": "01-redirect-url-saved" },
    { "click": "role=button[name=\"Отправить на модерацию\"]" },
    { "wait": 500 },
    { "screenshot": "02-submitted-for-review" },
    { "expectVisible": "text=На модерации" },
    { "click": "role=button[name=\"Проверить в своём филиале\"]" },
    { "wait": 500 },
    { "screenshot": "03-test-installed" },
    { "expectVisible": "text=Приложение подключено к вашему филиалу" }
  ]
}
