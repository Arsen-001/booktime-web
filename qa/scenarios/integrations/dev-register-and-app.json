{
  "route": "/biz/integrations/developers",
  "persona": "owner",
  "lang": "ru",
  "device": "desktop",
  "steps": [
    { "expectVisible": "[data-f~=\"F-13-028\"]" },
    { "screenshot": "01-register-empty" },
    { "click": "role=checkbox" },
    { "click": "role=button[name=\"Зарегистрироваться\"]" },
    { "screenshot": "02-register-validation-errors" },
    { "expectVisible": "text=Заполните это поле" },
    { "fill": "label:has-text(\"Название компании-разработчика\") ~ input, label:has-text(\"Название компании-разработчика\") ~ div input", "value": "Test Dev Co" },
    { "fill": "label:has-text(\"Для чего будет использоваться\") ~ textarea, label:has-text(\"Для чего будет использоваться\") ~ div textarea", "value": "Тестируем API" },
    { "fill": "label:text-is(\"Имя\") ~ input, label:text-is(\"Имя\") ~ div input", "value": "Иван Тест" },
    { "fill": "label:text-is(\"Email\") ~ input, label:text-is(\"Email\") ~ div input", "value": "dev@test.com" },
    { "click": "role=button[name=\"Зарегистрироваться\"]" },
    { "wait": 800 },
    { "expectVisible": "text=Кабинет разработчика создан" },
    { "screenshot": "03-registered-my-apps" },
    { "expectVisible": "[data-f~=\"F-13-032\"]" },
    { "click": "role=link[name=\"Создать приложение\"]" },
    { "wait": 500 },
    { "screenshot": "04-new-app-empty" },
    { "expectVisible": "[data-f~=\"F-13-030\"]" },
    { "fill": "label:has-text(\"Название приложения\") ~ input, label:has-text(\"Название приложения\") ~ div input", "value": "Мой Тестовый Виджет" },
    { "wait": 300 },
    { "screenshot": "05-new-app-id-autofill" },
    { "click": "label:has-text(\"Непубличное приложение\") input[type=checkbox]" },
    { "screenshot": "06-new-app-private-checked" },
    { "click": "role=button[name=\"Создать\"]" },
    { "wait": 800 },
    { "screenshot": "07-app-detail-general" },
    { "expectVisible": "[data-f~=\"F-13-033\"]" },
    { "click": "text=О приложении" },
    { "wait": 300 },
    { "screenshot": "08-app-about-tab" },
    { "expectVisible": "[data-f~=\"F-13-034\"]" },
    { "click": "text=Настройки для разработки" },
    { "wait": 300 },
    { "screenshot": "09-app-devsettings-tab" },
    { "expectVisible": "[data-f~=\"F-13-035\"]" },
    { "click": "text=Доступ к API" },
    { "wait": 300 },
    { "screenshot": "10-app-apiaccess-tab" },
    { "expectVisible": "[data-f~=\"F-13-036\"]" }
  ]
}
