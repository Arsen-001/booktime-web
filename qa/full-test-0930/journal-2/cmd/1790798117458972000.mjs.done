const M = await import('/Users/arsen/WebstormProjects/booking-platform/qa/full-test-0930/journal-2/t/common.mjs?' + Date.now());
const { waitReady, dlg, btns, toasts, go } = M;
export default async ({ browser, lib, state }) => {
  const p = state.owner; let o='';
  await go(p, '/biz/journal?booking=bk_2383&demo=owner&sphere=nails&lang=ru'); await waitReady(p); await p.waitForTimeout(1500);
  const w = p.locator('[role=dialog]').first();
  const t0 = await w.innerText(); const k = t0.indexOf('К оплате'); o += 'BEFORE ' + t0.slice(k, k+40).replace(/\n+/g,' ') + '\n';
  // open service line
  await w.getByRole('button', { name: /^Маникюр аппаратный/ }).first().click(); await p.waitForTimeout(800);
  const plus = w.getByRole('button', { name: /Увеличить|Больше|\+/ }).filter({ hasNot: p.locator('text=Добавить') });
  o += 'plus btns ' + await w.evaluate(d=>[...d.querySelectorAll('button')].filter(b=>/увелич|больше/i.test(b.getAttribute('aria-label')||'')).map(b=>b.getAttribute('aria-label')).join('|')) + '\n';
  const inc = w.locator('button[aria-label*="велич"], button[aria-label*="Больше"]').first();
  if (await inc.count()) { await inc.click(); await p.waitForTimeout(600); }
  const t1 = await w.innerText(); const k1 = t1.indexOf('К оплате'); o += 'AFTER+ ' + t1.slice(k1, k1+40).replace(/\n+/g,' ') + '\n';
  await lib.shot(p, 'o41-qty');
  // consumables tile
  await w.getByText('Списание расходников', { exact: true }).first().click(); await p.waitForTimeout(1200);
  o += 'CONS ' + (await p.locator('[role=dialog]').last().innerText()).slice(0,600).replace(/\n+/g,' / ') + '\n';
  await lib.shot(p, 'o41-consumables');
  return o;
};
